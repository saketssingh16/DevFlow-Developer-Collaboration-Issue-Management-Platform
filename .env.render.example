# Render / Aiven / Upstash deployment template. Use real secret values only in Render.
NODE_ENV=production
PORT=10000
APP_URL=https://your-service.onrender.com
CORS_ORIGIN=https://your-service.onrender.com
# URL-encode reserved characters in USER and PASSWORD. Render Secret File: /etc/secrets/aiven-ca.pem
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/devflow?sslcert=/etc/secrets/aiven-ca.pem&sslaccept=strict
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-unique-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
RUN_WORKER_IN_API=true
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-your-resend-api-key
EMAIL_FROM=DevFlow <noreply@your-verified-domain.com>
ATTACHMENTS_ENABLED=false
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
