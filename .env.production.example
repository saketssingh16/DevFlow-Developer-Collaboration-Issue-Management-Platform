# Copy to .env on the Oracle VM. Do not commit .env.
NODE_ENV=production
HTTP_PORT=80
HTTPS_PORT=443
CORS_ORIGIN=https://devflow.example.com
APP_URL=https://devflow.example.com
MYSQL_DATABASE=devflow
MYSQL_USER=devflow
MYSQL_PASSWORD=replace-with-a-unique-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-unique-root-password
REDIS_PASSWORD=
REDIS_URL=
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
STORAGE_PROVIDER=local
ATTACHMENTS_ENABLED=false
RUN_WORKER_IN_API=false
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
MAX_ATTACHMENT_SIZE_BYTES=10485760
ALLOWED_ATTACHMENT_MIME_TYPES=image/png,image/jpeg,image/gif,application/pdf,text/plain,text/markdown,application/zip
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
