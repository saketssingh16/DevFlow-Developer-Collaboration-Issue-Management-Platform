# Application
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
VITE_API_URL=/api/v1
VITE_WS_URL=

# MySQL (Docker Compose builds DATABASE_URL from MYSQL_* values)
MYSQL_DATABASE=devflow
MYSQL_USER=devflow
MYSQL_PASSWORD=replace-with-a-long-unique-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-unique-password
DATABASE_URL=mysql://devflow:replace-with-a-long-unique-password@localhost:3306/devflow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth: generate distinct values of at least 32 characters; never commit real values.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email verification: console logs messages locally. Set resend plus these values for real delivery.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
MAX_ATTACHMENT_SIZE_BYTES=10485760
ALLOWED_ATTACHMENT_MIME_TYPES=image/png,image/jpeg,image/gif,application/pdf,text/plain,text/markdown,application/zip
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional AI provider. Keep disabled unless a server-side key is configured.
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
